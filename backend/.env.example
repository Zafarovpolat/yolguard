# Yo'lGuard backend — пример конфигурации (скопируйте в .env)
DATABASE_URL=sqlite+aiosqlite:///./yolguard_dev.db
SECRET_KEY=change-me-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=10080
UPLOAD_DIR=./uploads
# Реальный ИИ-сервис подключается позже — задать URL и переключить ai_client на HTTP:
# AI_SERVICE_URL=https://ai.example.com
